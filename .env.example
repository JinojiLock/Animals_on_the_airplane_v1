# API Configuration
VITE_API_URL=http://localhost:3001/api

# Admin Panel Configuration
# Admin URL: Change this to a random URL for security (e.g., /admin-xyz789)
VITE_ADMIN_URL=/admin-panel-7k3m9x
# Admin Password: Change this in production!
VITE_ADMIN_PASSWORD=admin123

# Google Analytics
# Get your tracking ID from: https://analytics.google.com
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Yandex Metrika
# Get your counter ID from: https://metrica.yandex.com
# VITE_YM_COUNTER_ID=12345678

# Telegram Bot Configuration
# Как получить:
# 1. Создайте бота через @BotFather в Telegram
# 2. Скопируйте токен бота
# 3. Получите chat_id через @userinfobot или отправив сообщение боту и проверив https://api.telegram.org/bot<TOKEN>/getUpdates

VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# В dev режиме (npm run dev) форма работает без настроек Telegram - сообщения выводятся в консоль

